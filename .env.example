# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional model overrides (auto-detected from your key if blank)
SEVA_GEMINI_TEXT_MODEL=
SEVA_GEMINI_TTS_MODEL=
SEVA_GROQ_TEXT_MODEL=openai/gpt-oss-120b
SEVA_GROQ_STT_MODEL=whisper-large-v3
# Show the browser while the agent fills the form (1) or run headless (0)
SEVA_HEADED=1
